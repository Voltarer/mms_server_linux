<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B" release="4">
	<Header id="Switch" />
	 <Communication>
		<SubNetwork name="SubNetworkName">
		<ConnectedAP iedName="Switch" apName="AP1">
			<Address>
			<P type="OSI-AP-Title">1,3,9999,1</P>
			<P type="OSI-AE-Qualifier">12</P>
			<P type="OSI-PSEL">00000001</P>
			<P type="OSI-SSEL">0001</P>
			<P type="OSI-TSEL">0001</P>
			</Address>
		</ConnectedAP>
		</SubNetwork>
 	</Communication>
	<IED name="Switch">
		<AccessPoint name="AP1">
			<Server>
				<Authentication />
				<LDevice inst="Bridge">
					<LN0 lnClass="LLN0" inst="" lnType="LLN0_Type">
						<DataSet name="ds">							
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="PhyHealth" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="Proxy" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="NumPwrUp" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="WrmStr" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="WacTrg" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="PwrUp" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="PwrDn" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="PwrSupAlm" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="PwrFail" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="RAMHealth" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="ROMHealth" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="CPUFail" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="FWFail" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="TmpHealth" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="AuxIOUnitSt1" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="SrvConn" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="CybSecEvt" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="MemRs" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="CRFail" fc="ST"/>
							<FCDA ldInst="Bridge" lnClass="LPHD" lnInst="1" doName="CRChg" fc="ST"/>

							<FCDA ldInst="Bridge" lnClass="LPCP" lnInst="1" doName="Mau" fc="ST"/>
						</DataSet>
						
						<ReportControl rptID="Bridge/LLN0.RP.Events" 
								confRev="1" 
								buffered="false" 
								bufTime="1000" 
								name="urcbSW" 
								datSet="ds"
								intgPd="600000"
								resvTms="0">
							<TrgOps dchg="true" qchg="true" dupd="false" period="true" gi="true" />
							<OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" configRef="true" />
							<RptEnabled max="6" />
						</ReportControl>
					</LN0>
					<LN lnClass="LPHD" inst="1" lnType="HIRSCHMANN_ETHSWITCH_LPHD">
						<DOI name="PhyNam">
							<DAI name="model"/>
							<DAI name="location"/>
							<DAI name="serNum"/>
							<DAI name="vendor"/>
						</DOI>
						<DOI name="PhyHealth">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
						</DOI>
						<DOI name="PwrSupAlm">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
						</DOI>
						<DOI name="Proxy">
							<DAI name="stVal">
								<Val>0</Val>
							</DAI>
							<DAI name="t"/>
							<DAI name="q"/>
						</DOI>
						<DOI name="OpTmh">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
							<DAI name="dataNs"/>
							<DAI name="cdcNs"/>
							<DAI name="cdcName"/>
						</DOI>
						<DOI name="NumPwrUp">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
							<DAI name="dataNs"/>
							<DAI name="cdcNs"/>
							<DAI name="cdcName"/>
						</DOI>
						<DOI name="WrmStr">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
							<DAI name="dataNs"/>
							<DAI name="cdcNs"/>
							<DAI name="cdcName"/>
						</DOI>
						<DOI name="WacTrg">
							<DAI name="stVal"/>
							<DAI name="t"/>
							<DAI name="q"/>
							<DAI name="dataNs"/>
							<DAI name="cdcNs"/>
							<DAI name="cdcName"/>
						</DOI>
						<DOI name="OutOv"></DOI>
						<DOI name="InOv"></DOI>
						<DOI name="PwrFail"></DOI>
						<DOI name="RAMHealth"></DOI>
						<DOI name="ROMHealth"></DOI>
						<DOI name="CPUFail"></DOI>
						<DOI name="FWFail"></DOI>
						<DOI name="TmpHealth"></DOI>
						<DOI name="AuxIOUnitSt1"></DOI>
						<DOI name="SrvConn"></DOI>
						<DOI name="CybSecEvt"></DOI>
						<DOI name="CRFail"></DOI>										
						<DOI name="CRChg"></DOI>
					</LN>	
					<LN lnClass="LCCH" inst="1" lnType="HIRSCHMANN_ETHSWITCH_LCCH">
						<DOI name="PortRef"><DAI name="setSrcRef"><Val>Bridge/LPCP1</Val></DAI></DOI>
						<DOI name="RedPortRef"><DAI name="setSrcRef"><Val>Bridge/LPCP1</Val></DAI></DOI>
					</LN>
					
					<LN lnClass="LPCP" inst="1" lnType="HIRSCHMANN_ETHSWITCH_LPCP">
						<DOI name="PortNum"><DAI name="setVal"><Val>1</Val></DAI></DOI>
					</LN>
					
				</LDevice>
			</Server>
		</AccessPoint>
	</IED>
	<DataTypeTemplates>
		<LNodeType id="LLN0_Type" lnClass="LLN0">
			<DO name="Mod" type="INC_Type" />
			<DO name="Beh" type="INS_Type" />
		</LNodeType>
