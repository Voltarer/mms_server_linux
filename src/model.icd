			<DO name="MauCfg" type="HIRSCHMANN_ETHSWITCH_ING_90-4_0" />
			<DO name="MauCfgCap" type="HIRSCHMANN_ETHSWITCH_ING_90-4_0" />
			<DO name="AdminCfg" type="HIRSCHMANN_ETHSWITCH_SPG_90-4_0" />
			<DO name="InRef" type="HIRSCHMANN_ETHSWITCH_ORG_90-4_DO_0" />
