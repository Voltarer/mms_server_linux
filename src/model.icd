			<DO name="PwrSupAlm" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="PwrFail" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="RAMHealth" type="HIRSCHMANN_ETHSWITCH_ENS_1"/>	
			<DO name="ROMHealth" type="HIRSCHMANN_ETHSWITCH_ENS_1"/>	
			<DO name="CPUFail" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="FWFail" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="TmpHealth" type="HIRSCHMANN_ETHSWITCH_ENS_1"/>
			<DO name="AuxIOUnitSt1" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="SrvConn" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="CybSecEvt" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="MemRs" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="CRFail" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>										
			<DO name="CRChg" type="HIRSCHMANN_ETHSWITCH_SPS_0"/>
			<DO name="NamAuxVRtg" type="HIRSCHMANN_ETHSWITCH_VSD_0"/>
			<DO name="RsStat" type="HIRSCHMANN_ETHSWITCH_SPC_0"/>
